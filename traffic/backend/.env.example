# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (optional - for history tracking)
MONGODB_URI=mongodb://localhost:27017/smart-traffic

# Traffic System Configuration
DISTANCE_BETWEEN_SIGNALS_KM=2
DEFAULT_AVG_SPEED_KMPH=40
SIGNAL_TIMEOUT_MS=5000

# Green Wave Configuration
MIN_GREEN_WAVE_SPEED=32
MAX_GREEN_WAVE_SPEED=48

# Adaptive Mode Configuration
MIN_GREEN_TIME_SEC=30
MAX_GREEN_TIME_SEC=90
YELLOW_TIME_SEC=5
